@startuml
abstract class User {
  + String id
  + String username
  + String passwordHash
}

class RegularUser {
  + addFriend(RegularUser friend)
  + hidePublicCocktail(Cocktail cocktail)
}

class Admin {
  + addGlobalCocktail(Cocktail cocktail)
  + updateGlobalCocktail(Cocktail cocktail)
  + deleteGlobalCocktail(String cocktailId)
}

User <|-- RegularUser
User <|-- Admin

class Cocktail {
  + String id
  + String name
  + String imageUrl  <<changed>>
  + String primarySpirit
  + String glassType
  + String instructions
  + boolean isUserCreated
  + Date updatedAt
  + scaleServings(int count)
}

class Ingredient {
  + String id
  + String name
  + Date updatedAt
}

class CocktailIngredient {
  + String measure
}

class Tag {
  + String id
  + String name
  + editName(String newName)
  + deleteIfUnused()
}

class DrinkingSession {
  + String id
  + Date date
  + String location
}

class UserHistoryEntry {
  + String id
  + int rating
  + String notes
}

RegularUser "1" -- "many" Cocktail : creates (synced centrally) >
RegularUser "1" -- "many" Cocktail : hides public >
RegularUser "many" -- "many" RegularUser : friends >
RegularUser "1" -- "many" Ingredient : has in My Bar >
RegularUser "1" -- "many" Cocktail : favorites >

Cocktail "1" *-- "many" CocktailIngredient
Ingredient "1" -- "many" CocktailIngredient
Cocktail "many" -- "many" Tag : described by >

DrinkingSession "1" *-- "many" UserHistoryEntry : contains >
RegularUser "1" -- "many" UserHistoryEntry : logs >
DrinkingSession "many" -- "1" Cocktail : features >

Admin "1" -- "many" Cocktail : manages global >
Admin "1" -- "many" Ingredient : manages global >
@enduml