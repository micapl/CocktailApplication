<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource ResourceKey=PrimaryBGGradient}" Width="400" Height="400">
      <!-- Add Controls for Previewer Here -->
        <Button Content="Helloworld"/>
    </Border>
  </Design.PreviewWith>
  <!-- Add Styles Here -->
<!--Button Default Style-->
    <Style Selector="Button">
       <Setter Property="FontSize" Value="15"/>
       <Setter Property="FontFamily" Value="Segoe UI"/>
       <Setter Property="Background" Value="Black"/>
       <Setter Property="Foreground" Value="FloralWhite"/>
       <Setter Property="BorderBrush" Value="FloralWhite"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="HorizontalAlignment" Value="Stretch"/>
       <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#1E052B"/>
        <Setter Property="Foreground" Value="FloralWhite"/>
        <Setter Property="BorderBrush" Value="FloralWhite"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Resources>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused">White</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundFocused">#1E052B</SolidColorBrush>
        </Style.Resources>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="Background" Value="#1E052B"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A124C"/>
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#8F16A2"/>
        <Setter Property="Foreground" Value="FloralWhite"/>
    </Style>

    <Style Selector="CheckBox">
        <Style.Resources>
            <Color x:Key="SystemAccentColor">#FF8D37AF</Color>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FF8D37AF"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FFCD51FF"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundPointerOver" Color="#FFAA41D3"/>
            <SolidColorBrush x:Key="CheckBoxBorderBrushPointerOver" Color="#FFAA41D3"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundPressed" Color="#79159D"/>  
            <SolidColorBrush x:Key="CheckBoxCheckForegroundCheckedPointOver" Color="#79159D"/> 
        </Style.Resources>
    </Style>

  <Style Selector="Button /template/ ContentPresenter">
      
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"></BrushTransition>
        <BrushTransition Property="Foreground" Duration="0:0:0.15"></BrushTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"></TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ResourceKey=PrimaryFGHover}"/>
      <Setter Property="Background" Value="{DynamicResource ResourceKey=PrimaryBGHover}"/>
      <Setter Property="RenderTransform" Value="Scale(1.3 )" />
  </Style>

  <Style Selector="DockPanel">

        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.5" Easing="ExponentialEaseOut"/>
            </Transitions>
        </Setter>
  </Style>

  <Style Selector="Button.PhosphorButton">
    <Setter Property="FontFamily" Value="avares://client/Assets/Phosphor.ttf#Phosphor"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
</Styles>
