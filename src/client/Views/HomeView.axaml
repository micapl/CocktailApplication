<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:client.ViewModels"
             x:Class="client.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <DockPanel Margin="10">
  
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Favourites" Command="{Binding NavigateFavouritesCommand}"/>
            <Button Content="Make a Cocktail" Command="{Binding NavigateMakeCocktailCommand}"/>
            <Button Content="Categories" Command="{Binding NavigateCategoriesCommand}"/>
            <Button Content="Bar" Command="{Binding NavigateBarCommand}"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</UserControl>