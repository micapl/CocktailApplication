<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
        Width="1200" Height="600"
        x:Class="client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CockTail"
        Icon="/Assets/CockTail-icon.ico">
    <Grid Background="{DynamicResource PrimaryBGGradient}" ColumnDefinitions="250, *">
          <Border Padding="6" Background="{DynamicResource PrimaryBG}" CornerRadius="5" >
                <Grid Background="#350955">
                    <Grid Margin="4" RowDefinitions="*, Auto"> 
                        <DockPanel Grid.Column="0"  Margin="3" Background="Black">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*, *" Margin="4">
                <Button Grid.Column="0" 
                Content="Quit" 
                Command="{Binding QuitCommand}"/>
                <Button Grid.Column="1" 
                Content="Login" 
                Command="{Binding NavigateLoginCommand}"
                Margin="2,0,0,0"/>
    </Grid>  
    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <Image Source="/Assets/CockTailLogo.png"/>
    
    <Button Content="Search" 
            Command="{Binding NavigateSearchCommand}" />
            
    <Button Content="Home" 
            Command="{Binding NavigateHomeCommand}" />
            
    <Button Content="Social" 
            Command="{Binding NavigateSocialCommand}" />
            
    <Button Content="Settings" 
            Command="{Binding NavigateSettingsCommand}" />
         </StackPanel>
</DockPanel>    
                    </Grid>
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentView}" 
                        HorizontalContentAlignment="Stretch" 
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
