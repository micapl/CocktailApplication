<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
        Width="1200" Height="600"
        x:Class="client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CockTail">
    <Grid Background="{DynamicResource PrimaryBGGradient}" ColumnDefinitions="200, *">
          <Border Padding="6" Background="{DynamicResource PrimaryBG}" CornerRadius="3" >
                <Grid Background="#350955">
                    <Grid Margin="4" RowDefinitions="*, Auto"> 
                        <DockPanel Grid.Column="0"  Margin="4" Background="Black">
        <Button DockPanel.Dock="Bottom" Content="Quit" 
            Command="{Binding QuitCommand}" 
            Background="Black" Foreground="FloralWhite" BorderBrush="FloralWhite" BorderThickness="1" 
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2" />  
    <StackPanel DockPanel.Dock="Top" Spacing="5">
                        <Image Source="/Assets/CockTailLogo.png"/>
    
    <Button Content="Search" 
            Command="{Binding NavigateSearchCommand}" 
            Background="Black" Foreground="FloralWhite" BorderBrush="FloralWhite" BorderThickness="1" 
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
            
    <Button Content="Home" 
            Command="{Binding NavigateHomeCommand}" 
            Background="Black" Foreground="FloralWhite" BorderBrush="FloralWhite" BorderThickness="1" 
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
            
    <Button Content="Social" 
            Command="{Binding NavigateSocialCommand}" 
            Background="Black" Foreground="FloralWhite" BorderBrush="FloralWhite" BorderThickness="1" 
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
            
    <Button Content="Settings" 
            Command="{Binding NavigateSettingsCommand}" 
            Background="Black" Foreground="FloralWhite" BorderBrush="FloralWhite" BorderThickness="1" 
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2"/>
         </StackPanel>
</DockPanel>    
                    </Grid>
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentView}" 
                        HorizontalContentAlignment="Stretch" 
                        VerticalContentAlignment="Stretch" />
    </Grid>  
</Window>
