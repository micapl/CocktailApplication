<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
        Width="1200" Height="600"
             x:Class="client.Views.SearchView">
             
    <Grid Background="{DynamicResource ResourceKey=PrimaryBG2}" HorizontalAlignment="Stretch">
    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10">
        <TextBox Width="300" Height="30" PlaceholderText="Search for a cocktail..." />
        <Button Content="Search" Width="300"  />
        <ListBox Width="300" Height="300" Margin="0,3,0,0">
            <ListBoxItem Content="Margarita" />
            <ListBoxItem Content="Martini" />
            <ListBoxItem Content="Mojito" />
            <ListBoxItem Content="Old Fashioned" />
        </ListBox>
        <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0">
        <Button Content="Clear Results" Width="200" Height="30" Margin="0,3,0,0"/>
        <Button Content="View Details" Width="200" Height="30" Margin="0,3,0,0"/>
        </DockPanel>
        <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0">
        <Button Content="Filter by Ingredients" Width="200" Height="30" Margin="0,3,0,0"/>
        <Button Content="Sort by Popularity" Width="200" Height="30" Margin="0,3,0,0"/>
        </DockPanel>
        <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0">
        <Button Content="Sort by Rating" Width="200" Height="30" Margin="0,3,0,0"/>
        <Button Content="Advanced Search Options" Width="200" Height="30" Margin="0,3,0,0"/>
        </DockPanel>
    </StackPanel>
    </Grid>
</UserControl>