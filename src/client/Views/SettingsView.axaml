<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:client.ViewModels"
             x:Class="client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel Margin="10">
  
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Language" Command="{Binding NavigateLanguageCommand}"/>
                   </StackPanel>

        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</UserControl>