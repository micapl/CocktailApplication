<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="client.App"
             xmlns:local="using:client"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/Default.axaml"></StyleInclude>
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBG">#500085</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBG2">#EE611296</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryFG">#C4B4CF</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBGHover">#3B1655</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryFGHover">#7E6A8C</SolidColorBrush>
        <LinearGradientBrush x:Key="PrimaryBGGradient" StartPoint="0%, 0%" EndPoint="100%, 0%">
            <GradientStop Offset="0" Color="Black"></GradientStop> 
            <GradientStop Offset="1" Color="#500085"></GradientStop> 
        </LinearGradientBrush>
    </Application.Resources>
</Application>